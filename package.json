{
  "name": "voxelsynth",
  "version": "2.0.0",
  "description": "Local voxel and signed distance field CAD studio with counted mesh topology and verified STL, OBJ and OpenSCAD round trips",
  "main": "voxel.js",
  "scripts": {
    "test": "node --test --test-reporter=spec test.js export-test.js ui-test.js",
    "test:core": "node --test --test-reporter=spec test.js",
    "test:exports": "node --test --test-reporter=spec export-test.js",
    "test:ui": "node --test --test-reporter=spec ui-test.js"
  },
  "keywords": [
    "voxel",
    "sdf",
    "csg",
    "cad",
    "stl",
    "obj",
    "openscad",
    "3d-printing",
    "manifold"
  ],
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18"
  }
}
